# Local secrets — copy to .env.local (never commit real keys)

# Turso / libSQL (optional — without these, local SQLite file is used)
# Create a DB: https://turso.tech
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Local fallback when TURSO_DATABASE_URL is empty:
# file:./data/kitchen.db

# OpenAI / ChatGPT — enables real AI enrich on URL/text import
# Create a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional model override (default: gpt-4o-mini)
# OPENAI_MODEL=gpt-4o-mini

# Optional custom base URL (OpenAI-compatible proxies)
# OPENAI_BASE_URL=https://api.openai.com/v1
